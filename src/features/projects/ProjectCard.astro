---
import { cn } from "@lib/utils";

import CardIndex from "@components/CardIndex.astro";
import Button from "@components/Button.astro";

import type { Project } from "@data/projects";

import GithubIcon from "@assets/icons/brands/github.svg";

interface Props {
  project: Project;
  className?: string;
  detailed?: boolean;
}

const { project, className, detailed = true } = Astro.props;

const renderDetails = (text: string) =>
  text.replace(/\*\*(.+?)\*\*/g, '<strong class="font-bold text-accent">$1</strong>');
---

<div
  class={cn(
    "project bg-section-background backdrop-blur-sm relative w-full rounded-lg p-4 shadow-lg",
    className,
  )}
>
  <CardIndex>{project.index}</CardIndex>
  <div class="flex h-full flex-col gap-3">
    <div class="mb-4 flex flex-col items-end pl-10 text-right">
      <h2
        class={cn(
          "text-accent font-departuremono font-bold",
          detailed ? "text-dm-base" : "text-dm-sm",
        )}
      >
        {project.title}
      </h2>
      <p
        class="text-foreground font-departuremono text-dm-xs mt-1 font-bold opacity-60"
      >
        {project.tagline} · {project.year}
      </p>
    </div>
    <div
      class="mb-2 flex w-full items-center rounded-md"
      set:html={project.topBannerHtml}
    />
    <div
      class="bg-section-secondary/10 flex h-fit items-center justify-center rounded-md p-4 md:h-40"
    >
      <img src={project.logoLink} alt={project.title} class="h-fit" />
    </div>
    <p
      class="text-foreground first-letter:font-departuremono first-letter:bg-accent font-manrope first-letter:text-primary-background text-justify text-sm leading-relaxed font-bold hyphens-auto first-letter:float-left first-letter:mt-1 first-letter:mr-2 first-letter:p-1 first-letter:px-2 first-letter:text-3xl first-letter:leading-none"
      set:html={renderDetails(project.details)}
    />
    <div class="mt-auto flex flex-wrap items-center gap-2 pt-1">
      <div
        class="text-accent font-departuremono prose-img:max-h-10 prose-a:relative mb-2 flex w-full items-center justify-center gap-4 text-base"
        set:html={project.bottomBannerHtml}
      />
      <div class="flex flex-wrap gap-1.5">
        {
          project.tech.map((tech) => (
            <span class="border-accent/30 text-accent font-pixelify rounded-md border px-1.5 py-0.5 text-xs font-bold">
              {tech}
            </span>
          ))
        }
      </div>
      <div class="prose-a:relative ml-auto flex items-center gap-2">
        <Button
          as="a"
          href={project.link}
          target="_blank"
          variant="link"
          class="text-accent font-bold"
          aria-label={`${project.title} on GitHub`}
        >
          <GithubIcon class="h-5 w-5 fill-current" />
          Repo
        </Button>
        {
          project.siteLink && (
            <>
              <p class="text-accent text-dm-base">|</p>
              <Button
                as="a"
                href={project.siteLink}
                target="_blank"
                variant="link"
                class="text-accent font-bold"
                aria-label={`${project.title} Site`}
              >
                Site
              </Button>
            </>
          )
        }
      </div>
    </div>
  </div>
</div>
