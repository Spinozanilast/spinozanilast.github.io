---
import { cn } from "@lib/utils";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  date?: string;
  timePercentage: number;
}

const { date, timePercentage, class: className, ...attrs } = Astro.props;
---

<div class={cn("timeline-item", className)} {...attrs}>
  <p class="time-percentage">{timePercentage}%</p>
  <div class="timeline-dot">
    <div class="timeline-dot-inner"></div>
  </div>
  <div class="timeline-content">
    {date && <span class="timeline-date">{date}</span>}
    <div class="timeline-card">
      <slot />
    </div>
  </div>
</div>

<style>
  @reference "../../global.css";

  .timeline-item {
    @apply relative mb-8 last:mb-0;

    &::before {
      @apply border-l-accent absolute top-8 -left-7 h-[92%] border-l-2 border-dashed;
      content: "";
    }

    .time-percentage {
      @apply font-departuremono text-dm-sm text-section-secondary bg-section-background absolute top-[45%] -left-13 rounded-md p-1 backdrop-blur-xl select-none;
    }
  }

  .timeline-dot {
    @apply absolute top-1 -left-9 z-10 flex h-4 w-4 items-center justify-center;

    .timeline-dot-inner {
      @apply border-accent bg-section-background h-3 w-3 rounded-full border-2 shadow-[0_0_8px_var(--accent-color)] transition-all duration-300;

      &:hover {
        background: var(--accent-color);
        transform: scale(1.3);
      }
    }
  }

  .timeline-content {
    @apply flex flex-col gap-1;
  }

  .timeline-date {
    @apply font-manrope text-xs font-semibold tracking-wide uppercase;
    color: var(--accent-color);
    opacity: 0.8;
  }

  .timeline-card {
    @apply rounded-lg p-4;
    background: var(--section-background);
    border: 1px solid var(--section-secondary);
    transition: all 0.2s ease;

    &:hover {
      border-color: var(--accent-color);
      box-shadow: 0 2px 12px color-mix(in srgb, var(--accent-color) 20%, transparent);
    }
  }
</style>
