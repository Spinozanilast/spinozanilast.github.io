---
import { cn } from "@/lib/utils";

import GithubIcon from "@assets/icons/brands/github.svg";

import githubContribs from "@data/github-contribs.json";

type Props = {
  className?: string;
  hideHeader?: string;
};

const { className, hideHeader = true } = Astro.props;

function randomMonthBackground() {
  const hue = Math.floor(Math.random() * 360);
  return `hsla(${hue}, 80%, 60%, 0.15)`;
}
---

<div
  class={cn(
    "fill-accent rounded-md p-2 w-full h-full justify-center text-center flex flex-col items-center",
    className,
  )}
>
  {
    !hideHeader && (
      <h2 class="text-dm-sm font-departuremono text-accent flex items-center gap-2 font-bold">
        <GithubIcon class="size-10 lg:size-14" />
        Github Contributions
      </h2>
    )
  }
  {
    githubContribs.map((contribMonth, idx) => {
      const rowsNumber = Math.ceil(contribMonth.days.length / 5);
      const maxMonthDays =
        contribMonth.daysInMonth < rowsNumber * 5
          ? contribMonth.daysInMonth
          : rowsNumber * 5;
      const emptyCells = contribMonth.fulfilled
        ? 0
        : maxMonthDays - contribMonth.days.length;
      return (
        <div
          class="github-stats__month relative my-4 w-fit rounded-md p-2"
          style={{ "background-color": randomMonthBackground() }}
        >
          <p class="text-dm-sm font-departuremono text-accent mb-2 text-center font-bold">
            {contribMonth.month}
          </p>
          <div
            class="grid grid-cols-5 justify-center gap-2"
            style={{ "grid-template-rows": `repeat(${rowsNumber}, minmax(0, 1fr))` }}
          >
            {contribMonth.days.map((day) => (
              <span
                class={`github-stats__level h-5 w-8 rounded-sm level-${day.level}`}
                data-date={day.date}
                data-info={day.tooltipText}
              />
            ))}
            {rowsNumber > 0 &&
              Array.from({ length: emptyCells }).map(() => <span class="empty" />)}
            <div class="github-stats__info" />
          </div>
        </div>
      );
    })
  }
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".github-stats__month").forEach((month) => {
      const tooltip = month.querySelector(".github-stats__info") as HTMLDivElement;
      if (!tooltip) return;
      month.querySelectorAll(".github-stats__level").forEach((level) => {
        level.addEventListener("mouseenter", () => {
          const info = level.getAttribute("data-info");
          if (info) {
            tooltip.textContent = info;
            tooltip.classList.add("info-visible");
          }
        });
        level.addEventListener("mouseleave", () => {
          tooltip.classList.remove("info-visible");
        });
      });
    });
  });
</script>

<style>
  @reference "../../global.css";

  .level-0 {
    @apply bg-level-0;
  }
  .level-1 {
    @apply bg-level-1;
  }
  .level-2 {
    @apply bg-level-2;
  }
  .level-3 {
    @apply bg-level-3;
  }
  .level-4 {
    @apply bg-level-4;
  }

  span.empty {
    @apply border-accent h-5 w-8 rounded-sm border border-dashed;
  }

  .github-stats__info {
    @apply bg-section-background font-departuremono text-dm-xs md:text-dm-sm pointer-events-none absolute top-[105%] z-10 w-fit rounded-md p-2 whitespace-nowrap opacity-0 transition-opacity duration-300 md:top-0 md:left-[102%];

    &.info-visible {
      opacity: 1;
    }
  }
</style>
