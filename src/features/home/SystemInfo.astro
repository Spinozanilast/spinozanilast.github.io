              transform="translate(-14.789 -180.434)scale(4.2056)"
            >
            </path>
          </g>
        </g>
      </g>
      <g style="fill:#fff59b;fill-opacity:1">
        <path
          d="M11.646 43.643a7.314 7.314 0 0 0-7.312 7.312 7.314 7.314 0 0 0 7.312 7.315 7.314 7.314 0 0 0 7.159-5.899 6.22 6.22 0 0 1-3.416 3.465c.001.277.004.532.004.727a6.5 6.5 0 0 1-1.922-.272 6 6 0 0 1-.442.035 6.22 6.22 0 0 1-6.22-6.22 6.22 6.22 0 0 1 6.22-6.221 6 6 0 0 1 .576.027 7.3 7.3 0 0 0-1.959-.27"
