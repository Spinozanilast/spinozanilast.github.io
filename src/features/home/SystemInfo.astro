        </path><g style="fill:#2b1100;fill-opacity:1">
          <path
            d="M168.507 903.265c15.318-19.148 46.72-28.339 67.655-15.063-24.509-3.83-46.72 2.553-67.655 15.063"
            style="clip-rule:evenodd;fill-rule:evenodd;stroke-width:2.55301046;fill:#2b1100;fill-opacity:1"
          >
