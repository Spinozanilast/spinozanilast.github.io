      </g>
      <path
        d="M42.664 31.291c-1.802 2.024-4.95 2.493-8.525 2.503-2.718-.007-5.45-.128-7.27-1.39-1.816.325-2.579 2.345-2.415 4.704C25.618 53.93 36.27 52.842 36.366 52.815c-7.794-3.803-6.517-10-6.773-11.976.321 3.343 3.896 12.857 17.236 12.857 0-4.01.02-14.31-1.28-17.487-.409-1.237-1.525-4.547-2.885-4.918"
        style="fill:#a9aefe;fill-opacity:1;stroke:none;stroke-width:1.34608;stroke-miterlimit:9.1;paint-order:fill markers stroke"
      >
