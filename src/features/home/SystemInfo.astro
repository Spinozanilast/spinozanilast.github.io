---
import { Archlinux, Hyprland } from "simple-icons-astro";
import { Image } from "astro:assets";
---

<div
  class="font-departuremono grid auto-rows-auto grid-cols-1 gap-3 md:max-h-96 md:overflow-y-auto @min-[600px]:grid-cols-2"
>
  <!-- OS -->
  <div class="ti">
    <svg
      role="img"
      class="ico fill-[#00AA88]"
      viewBox="0 0 24 24"
      xmlns="http://www.w3.org/2000/svg"
    >
      <title>CachyOS</title>
      <path
        d="M5.301 2.646 0 11.771l5.541 9.583h11.486l2.904-5.017H8.102l-2.56-4.429L8.067 7.54h6.063l2.83-4.893ZM20.058 4.12a.748.748 0 0 0 0 1.496.748.748 0 0 0 0-1.496m-1.983 4.303a1.45 1.45 0 0 0 0 2.9 1.45 1.45 0 0 0 0-2.9m4.02 3.98a1.904 1.904 0 0 0 0 3.809 1.904 1.904 0 0 0 0-3.81"
      >
      </path>
    </svg>
    <div class="info">
      <h3 class="th">OS</h3>
      <h2 class="desc">
        <a
          class="link arrow text-[#00AA88] decoration-[#00AA88]"
          href="https://cachyos.org/"
          target="_blank"
        >
          Cachy OS
        </a>
        (Linux Distro)
      </h2>
    </div>
  </div>

  <!-- Window Compositor -->
  <div class="ti">
    <Hyprland class="ico text-[#58E1FF]" />
    <div class="info">
      <h3 class="th">Window Compositor</h3>
      <h2 class="desc">
        Using
        <a
          class="link arrow text-[#58E1FF] decoration-[#58E1FF]"
          href="https://hypr.land/"
          target="_blank"
        >
          Hyprland
        </a>
      </h2>
    </div>
  </div>

  <!-- Desktop Shell -->
  <div class="ti">
    <svg xmlns="http://www.w3.org/2000/svg" class="ico" viewBox="0 0 67.733 67.733">
      <title>Noctalia</title>
      <g
        style="fill:#fff;fill-opacity:1;stroke:#0e0e43;stroke-width:6.2176;stroke-dasharray:none;stroke-opacity:1"
      >
        <g
          style="fill:#fff;fill-opacity:1;stroke:#0e0e43;stroke-width:17.9823;stroke-dasharray:none;stroke-opacity:1"
        >
          <g
            style="fill:#fff;fill-opacity:1;stroke:#0e0e43;stroke-width:1.4785;stroke-dasharray:none;stroke-opacity:1"
          >
            <path
              d="M11.647 43.643a7.314 7.314 0 0 0 0 14.627 7.314 7.314 0 0 0 7.158-5.899 6.22 6.22 0 0 1-3.416 3.465c.001.277.004.532.004.726a6.5 6.5 0 0 1-1.922-.271 6 6 0 0 1-.442.035 6.22 6.22 0 1 1 .576-12.414 7.3 7.3 0 0 0-1.959-.27m-3.139 3.085c.145.444.436.881.827 1.047-.109.329-.11.72-.11 1.137 0 .905.644 1.676 1.549 1.983-.33-.041-.632-.123-.868-.287-.432.077-.614.558-.575 1.119.277 4 2.81 3.741 2.832 3.734-1.853-.904-1.549-2.377-1.61-2.847.076.795.926 3.057 4.098 3.057 0-.953.005-3.403-.304-4.158-.097-.294-.362-1.081-.686-1.17-.262.295-.644.45-1.095.528.868-.323 1.477-1.078 1.477-1.959 0-.418 0-.808-.11-1.137.392-.166.684-.603.828-1.047-.472-.007-1.224.167-1.866.187-.322-.083-.734-.13-1.26-.13-.527 0-.94.047-1.26.13-.642-.02-1.394-.194-1.867-.187"
