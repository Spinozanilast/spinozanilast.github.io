---
import HomeLayout from "@layouts/HomeLayout.astro";
import TableOfContents from "@components/TableOfContents.tsx";

type Props = {
  title: string;
  headings?: { depth: number; slug: string; text: string }[];
};

const { title, headings = [] } = Astro.props;
---

<HomeLayout
  title={title}
  className="flex w-full flex-col items-center justify-self-center px-4"
>
  <slot name="top-bar" />
  <div
    class="relative flex w-full flex-col items-center justify-center py-4 lg:flex-row-reverse"
  >
    {
      headings.length > 0 && (
        <aside class="toc-sidebar">
          <div class="markdown-content text-accent">
            <h5 class="hidden md:block">
              <i>Table of Contents</i>
            </h5>
            <h1 class="block md:hidden">
              <i>Table of Contents</i>
            </h1>
            <hr />
          </div>
          <TableOfContents headings={headings} client:load />
          <div class="markdown-content text-accent">
            <hr />
          </div>
        </aside>
      )
    }
    <div
      class="markdown-content bg-section-background flex w-full flex-col justify-center rounded-md p-4 backdrop-blur-xs md:w-1/2"
    >
      <slot />
    </div>
  </div>
</HomeLayout>

<style is:global>
  @reference "../global.css";

  .toc-sidebar {
    @apply prose-a:text-dm-sm md:prose-a:text-dm-xs bg-section-background mb-8 w-full shrink-0 p-4 backdrop-blur-xs;
  }

  @media (min-width: 769px) {
    .toc-sidebar {
      @apply sticky top-80 mb-0 ml-8 max-h-[calc(100vh-8rem)] w-80 self-start overflow-y-auto;
    }
  }

  .markdown-content {
    @apply prose-headings:text-accent prose-headings:font-departuremono font-manrope;

    h1 {
      @apply text-dm-xl mb-2;
    }

    h2 {
      @apply text-dm-lg text-accent mt-10 mb-4 pb-2 underline decoration-wavy decoration-2 underline-offset-8;
    }

    h3 {
      @apply text-dm-sm text-accent mt-6 mb-2;
    }

    h4 {
      @apply text-accent mt-4 mb-2 text-lg;
    }

    p {
      @apply my-2 leading-relaxed;
    }

    a {
      @apply text-accent underline underline-offset-2 transition-[color_0.2s];

      &:hover {
        color: var(--actions);
      }
    }

    strong {
      @apply text-accent font-bold;
    }

    em {
      @apply italic opacity-80;
    }

    hr {
      @apply my-6 border-t-[1px_solid_var(--section-secondary)];
    }

    blockquote {
      @apply text-foreground my-4 border-l-[3px_solid_var(--accent-color)] pl-4 italic opacity-90;
    }

    ul {
      @apply my-2 list-inside list-disc pl-2;

      li {
        @apply my-1 leading-relaxed;
      }
    }

    ol {
      @apply my-2 list-inside list-decimal pl-2;

      li {
        @apply my-1 leading-relaxed;
      }
    }

    table {
      @apply mx-auto my-4 border-collapse p-4 text-left text-sm;

      tbody {
        @apply border-accent border-y border-solid;
      }

      th {
        @apply text-accent border-b-[2px_solid_var(--section-secondary)] px-3 py-2 font-bold;
      }

      td {
        @apply border-b-[1px_solid_var(--section-secondary)] px-3 py-2;
      }

      th,
      td {
        @apply p-4;
      }

      tbody tr:nth-child(odd) {
        @apply bg-section-background;
      }

      tbody tr:nth-child(even) {
        @apply bg-transparent;
      }

      tr:last-child td {
        @apply border-b-[2px_solid_var(--section-secondary)];
      }
    }

    code {
      @apply bg-section-background text-foreground-top-accent rounded px-1.5 py-0.5 text-sm;
    }

    pre {
      @apply bg-section-background my-4 overflow-x-auto rounded-lg border-[1px_solid_var(--section-secondary)] p-4;

      code {
        @apply text-foreground bg-none p-0;
      }
    }

    img {
      @apply my-4 max-w-full rounded-lg;
    }

    details {
      @apply bg-section-background my-3 rounded-lg p-4;
      interpolate-size: allow-keywords;

      summary {
        @apply text-accent cursor-pointer font-bold opacity-100 select-none;

        &:hover {
          @apply text-actions;
        }

        :is(strong) {
          @apply opacity-100;
        }
      }

      > :not(summary) {
        @apply text-balance;
      }

      &::details-content {
        height: 0;
        overflow: hidden;
        transition:
          height 0.3s ease,
          content-visibility 0.3s allow-discrete;
      }

      &[open]::details-content {
        height: auto;
      }
    }

    kbd {
      @apply bg-section-background border-section-secondary rounded border px-1.5 py-0.5 font-mono text-sm;
    }
  }
</style>
