---
import Button from "@components/Button.astro";
---

<Button
  variant="icon"
  class="color-toggle text-foreground"
  aria-label="Theme color selector"
>
  <span class="preview-symbol">♦</span>
  <div class="variants-wrapper">
    <p class="md:text-dm-xs font-departuremono text-left italic">Choose theme color:</p>
    <div class="colors-variants-selector"></div>
  </div>
</Button>

<script>
  const COLORS = ["orange", "red", "green", "purple", "blue", "black"];
  const PREFERRED_COLOR = "red";

  document.addEventListener("DOMContentLoaded", () => {
    const root = document.documentElement;

    const savedColor = localStorage.getItem("theme-accent") || "red";
    const currentColor = savedColor;

    const styles = getComputedStyle(root);

    const COLORS_MAP = Object.fromEntries(
      COLORS.map((color) => {
        root.setAttribute("data-color", color);
        return [color, styles.getPropertyValue("--accent-color").trim()];
      }),
    );

    root.setAttribute("data-color", currentColor);

    document.querySelectorAll(".color-toggle").forEach((button) => {
      const colorsVariantsSelector = button.querySelector(".colors-variants-selector");

      const select = (color: (typeof COLORS)[number]) => {
        colorsVariantsSelector!
          .querySelectorAll(".color-variant")
          .forEach((variant) => {
            variant.classList.toggle(
              "current-one",
              variant.getAttribute("data-color") === color,
            );
          });
      };

      Object.entries(COLORS_MAP).forEach(([color, accent]) => {
        const colorVarButton = document.createElement("button");
        colorVarButton.setAttribute("data-color", color);
        colorVarButton.classList.add("color-variant", color);
        colorVarButton.style.color = accent;
        colorVarButton.textContent = "♦";
        colorVarButton.title = `Set accent color to ${color}`;

        if (color === PREFERRED_COLOR) {
          colorVarButton.classList.add("key-one");
        }
        colorVarButton.addEventListener("click", () => {
          localStorage.setItem("theme-accent", color);
          root.setAttribute("data-color", color);
          select(color);
        });

        colorsVariantsSelector!.append(colorVarButton);
      });

      select(currentColor);
    });
  });
</script>

<style is:global>
  @reference "../global.css";

  .color-toggle {
    @apply relative;

    .preview-symbol {
      @apply text-accent text-shadow-primary-background font-departuremono text-dm-base text-shadow-md;
    }

    .variants-wrapper {
      @apply bg-util-panel-background shadow-accent fixed top-10 right-0 z-100 hidden w-80 min-w-60 flex-col items-center gap-2 rounded-md p-2 md:w-fit;

      .colors-variants-selector {
        @apply grid w-3/4 grid-cols-3 place-items-center items-center gap-2 md:flex md:w-full md:flex-row;

        .color-variant {
          @apply bg-accent font-departuremono text-dm-sm h-16 w-full cursor-pointer rounded-sm px-3 py-1 text-shadow-md hover:scale-105;

          &.key-one {
            @apply outline-3 outline-yellow-500;
          }

          &.current-one {
            @apply outline-accent outline-2 outline-offset-1 outline-solid;

            &.key-one {
              @apply outline-3 outline-yellow-500;
            }
          }
        }
      }
    }

    &:hover {
      .preview-symbol {
        display: none;
      }

      &::before {
        @apply text-foreground font-departuremono text-dm-sm content-['↴'] text-shadow-md;
      }

      .variants-wrapper {
        @apply flex w-fit;
      }
    }
  }
</style>
