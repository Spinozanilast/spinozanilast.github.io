---
import { cn } from "@lib/utils";

import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"h1"> {}

const { class: className, ...attrs } = Astro.props;
---

<h1
  class={cn(
    "idx font-departuremono text-dm-5xl md:text-dm-6xl text-shadow-lg text-shadow-accent text-accent absolute -top-8 -left-1 italic",
    className,
  )}
  {...attrs}
>
  <slot />
</h1>
