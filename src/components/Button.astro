---
import { cn } from "@lib/utils";

import type { HTMLAttributes } from "astro/types";

type Variant = "icon" | "solid" | "ghost" | "subtle" | "link";
type Size = "sm" | "md" | "lg";

interface Props extends HTMLAttributes<"button"> {
  as?: "button" | "a";
  href?: string;
  target?: string;
  variant?: Variant;
  size?: Size;
}

const {
  as: Tag = "button",
  variant = "solid",
  size = "md",
  class: className,
  ...attrs
} = Astro.props;

const isLink = variant === "link";
const variantClass = isLink
  ? "link arrow"
  : cn(`btn-${variant}`, variant !== "icon" && `btn-${size}`);
---

<Tag class={cn(isLink ? undefined : "btn", variantClass, className)} {...attrs}>
  <slot />
</Tag>
